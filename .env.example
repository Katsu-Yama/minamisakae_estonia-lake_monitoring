# GitHub ActionsではSecrets/Variablesとして登録し、このファイルは使用しません。
GEE_PROJECT_ID=YOUR_GEE_CLOUD_PROJECT_ID
GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_IMAGE_BUCKET=satellite-images
SUPABASE_CSV_BUCKET=satellite-csv

# 必要な場合のみ変更
LOOKBACK_DAYS=21
WATER_MASK_START_DATE=2021-01-01
CLOUD_OVER_WATER_THRESHOLD=30.0
MIN_VALID_RATIO=0.3
MAX_IMAGES_PER_RUN=0
IMAGE_RETENTION_DAYS=365
